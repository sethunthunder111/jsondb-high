{
  "name": "jsondb-high",
  "version": "6.0.0",
  "description": "Blazing fast, Rust-powered JSON database for Node.js. MVCC concurrency, mmap O(1) startup, WAL replication, PITR, .explain() introspection, pluggable storage adapters, WASM fallback. ~2.5M/s reads, ~545k/s writes.",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "build": "node scripts/build-on-demand.js",
    "build:wasm": "node scripts/build-wasm.js",
    "build:prebuilds": "node scripts/build-prebuilds.js",
    "build:lite": "node scripts/build-lite.js",
    "build:all": "node scripts/build-prebuilds.js && node scripts/build-wasm.js && node scripts/build-lite.js",
    "test": "bun test tests/",
    "bench": "bun benchmarks/run.ts",
    "clean": "bun scripts/clean.ts",
    "postinstall": "node scripts/build-on-demand.js"
  },
  "keywords": [
    "json",
    "database",
    "rust",
    "n-api",
    "in-memory",
    "wal",
    "nosql",
    "fast",
    "storage",
    "typescript",
    "encryption",
    "acid",
    "durable",
    "multi-process",
    "safety",
    "group-commit",
    "performance",
    "mvcc",
    "mmap",
    "pitr",
    "replication",
    "wasm",
    "concurrency",
    "query-engine",
    "embedded-database"
  ],
  "author": "sethunthunder111",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sethunthunder111/jsondb-high.git"
  },
  "bugs": {
    "url": "https://github.com/sethunthunder111/jsondb-high/issues"
  },
  "homepage": "https://sethunthunder111.github.io/jsondb-high",
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4",
    "@types/bun": "latest",
    "@types/node": "^20.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "engines": {
    "node": ">= 16.0.0"
  }
}
